<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="gradle.xml">com.intellij.gradle</depends>
    <depends optional="true" config-file="android-studio.xml">org.jetbrains.android</depends>
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools" instance="io.github.anjiemo.filelockinspector.LanguageConfigurable" id="filelockinspector.settings" displayName="File Lock Inspector"/>
    </extensions>
    <actions>
        <action id="FileLockInspector.Inspect" class="io.github.anjiemo.filelockinspector.InspectAction" text="File Lock Inspector" description="Inspect processes using a file" icon="/icons/fileLock.svg">
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="SearchEverywhere"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
